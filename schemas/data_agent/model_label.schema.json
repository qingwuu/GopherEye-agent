{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gophereye.local/schemas/data_agent/model_label.schema.json",
  "title": "Data Agent Model Label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "model_label_id",
    "instance_id",
    "created_at",
    "label_source",
    "generation_status",
    "review_status",
    "is_ground_truth",
    "evidence_status",
    "source",
    "model",
    "route",
    "context_label",
    "image_ids",
    "assistant_message",
    "model_diagnosis",
    "visual_intakes",
    "evidence_present",
    "evidence_missing",
    "recommended_next_image",
    "selected_pages",
    "envelope",
    "raw_artifacts"
  ],
  "properties": {
    "record_type": { "const": "model_label" },
    "schema_version": { "const": "data_agent.model_label.v1" },
    "model_label_id": { "type": "string", "minLength": 1 },
    "instance_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "label_source": { "const": "existing_session_agent_output" },
    "generation_status": { "const": "machine_generated" },
    "review_status": { "const": "unreviewed" },
    "is_ground_truth": { "const": false },
    "evidence_status": {
      "type": "string",
      "enum": [
        "provisional_label",
        "single_surface_sufficient_label",
        "insufficient_evidence"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "additionalProperties": true
    },
    "route": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "context_label": { "type": ["string", "null"] },
    "image_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assistant_message": {
      "type": "object",
      "additionalProperties": true
    },
    "model_diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence", "raw_current_diagnosis"],
      "properties": {
        "label": { "type": "string" },
        "confidence": { "type": "string" },
        "raw_current_diagnosis": {}
      }
    },
    "visual_intakes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "evidence_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_missing": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_image": { "type": ["string", "null"] },
    "selected_pages": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parsed_json", "valid", "schema", "fallback_used", "validation_errors"],
      "properties": {
        "parsed_json": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "schema": { "type": ["string", "null"] },
        "fallback_used": { "type": "boolean" },
        "validation_errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "raw_artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gophereye.local/schemas/base/agent_trace.schema.json",
  "title": "Agent Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_type", "selected_agent_path", "needs_follow_up"],
  "properties": {
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "selected_agent_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "needs_follow_up": {
      "type": "boolean"
    }
  }
}
